{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"customGradient": false,
			"palette": [
				{ "slug": "musta", "name": "Musta", "color": "#0a0a0a" },
				{ "slug": "valkoinen", "name": "Valkoinen", "color": "#ffffff" },
				{ "slug": "vaalea", "name": "Vaaleanharmaa", "color": "#f3f3f3" },
				{ "slug": "harmaa", "name": "Harmaa", "color": "#5c5c5c" },
				{ "slug": "reuna", "name": "Reunaviiva", "color": "#d9d9d9" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1120px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 10vw, 7rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pieni", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Normaali", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Iso", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Erittäin iso", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Otsikko", "size": "3.25rem", "fluid": { "min": "1.875rem", "max": "3.25rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--valkoinen)",
			"text": "var(--wp--preset--color--musta)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			},
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--musta)",
					"text": "var(--wp--preset--color--valkoinen)"
				},
				"border": { "radius": "6px" },
				"spacing": {
					"padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.75rem", "right": "1.75rem" }
				},
				"typography": {
					"fontSize": "0.95rem",
					"fontWeight": "700"
				},
				":hover": {
					"color": { "background": "#333333" }
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "0.95rem", "fontWeight": "600" }
			},
			"core/site-title": {
				"typography": { "fontSize": "1.25rem", "fontWeight": "800", "letterSpacing": "-0.01em" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/list": {
				"spacing": { "padding": { "left": "1.25rem" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Ylätunniste", "area": "header" },
		{ "name": "footer", "title": "Alatunniste", "area": "footer" }
	]
}
